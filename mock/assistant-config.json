{
  "config": {
    "version": 1,
    "assistant_enabled": true,
    "keyword_alert_enabled": true,
    "allow_wechat_send": false,
    "alert_groups": [
      {
        "chat_id": "12345678@chatroom",
        "group_name": "技术交流群",
        "keywords": ["紧急", "BUG", "线上问题"],
        "enabled": true
      }
    ],
    "digest_groups": [
      {
        "chat_id": "12345678@chatroom",
        "group_name": "技术交流群",
        "schedule": ["09:00"],
        "cron_expr": "0 9 * * *",
        "lookback_hours": 6,
        "enabled": true,
        "unread_only": true,
        "push_target": "ilink",
        "profile": {
          "purpose": "技术交流",
          "description": "一个关于技术讨论的群聊",
          "focus_points": ["技术问题", "代码分享", "工具推荐"],
          "ignore_content": ["闲聊", "表情包"],
          "style": "简洁专业",
          "custom_prompt": ""
        }
      },
      {
        "chat_id": "23456789@chatroom",
        "group_name": "家人群",
        "schedule": ["12:00"],
        "cron_expr": "0 12 * * *",
        "lookback_hours": 4,
        "enabled": true,
        "unread_only": false,
        "push_target": "",
        "profile": {
          "purpose": "家庭沟通",
          "description": "家人的日常交流群",
          "focus_points": ["生活安排", "聚餐计划"],
          "ignore_content": [],
          "style": "温暖简洁",
          "custom_prompt": ""
        }
      }
    ],
    "notification_queue": {
      "enabled": true,
      "retention_hours": 48
    },
    "oa_monitor_groups": [
      {
        "id": "oa-monitor-1",
        "name": "AI 行业快讯",
        "accounts": ["gh_ai_frontier", "gh_technology_daily"],
        "enabled": true,
        "push_target": "ilink",
        "custom_prompt": "请用 1-2 句话提炼文章核心观点和影响。",
        "dnd_start": "22:00",
        "dnd_end": "08:00"
      },
      {
        "id": "oa-monitor-2",
        "name": "开发者动态",
        "accounts": ["gh_python_weekly", "gh_dev_life"],
        "enabled": false,
        "push_target": "",
        "custom_prompt": "重点关注工具、版本和实践细节。",
        "dnd_start": "",
        "dnd_end": ""
      }
    ],
    "oa_full_text_fetch": {
      "enabled": true,
      "ignore_gh_ids": ["gh_product_thinking"]
    },
    "outbox_retention_hours": 48
  }
}
